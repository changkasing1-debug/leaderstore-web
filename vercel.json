{
  "version": 2,
  "routes": [
    {
      "src": "/(assets|brands|products|reviews|images|styles|scripts)/.*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/[^.]+",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
